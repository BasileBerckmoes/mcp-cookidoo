# Cookidoo Credentials
COOKIDOO_EMAIL=your-email@example.com
COOKIDOO_PASSWORD=your-password-here

# Cookidoo locale (default: ch / de-CH). Set both to match your account,
# e.g. country=be language=nl-BE, or country=de language=de-DE.
COOKIDOO_COUNTRY=ch
COOKIDOO_LANGUAGE=de-CH

# HTTP server config (only needed when running as HTTP server, not stdio)
COOKIDOO_MCP_MODE=http           # "http" or "stdio"
COOKIDOO_MCP_PORT=8001           # local bind port
COOKIDOO_API_TOKEN=              # Bearer token for /mcp; leave empty to disable middleware auth
COOKIDOO_QUALITY_BAR=70          # min score 0-100 required by upload_custom_recipe
